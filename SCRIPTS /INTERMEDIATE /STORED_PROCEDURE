truncate table  [intermediate].[CRM_CUSTOMER] 
GO
GO
insert into   [intermediate].[CRM_CUSTOMER]  (
			CUSTOMER_KEY ,
		   CUSTOMER_ID ,
		   CUSTOMER_NAME ,
		   GENDER ,
		   COUNTRY_CITY ,
		   SIGNUP_DATE ,
		   CUSTOMER_SEGMENT,
		   EMAIL  ) 
		   SELECT    
            ROW_NUMBER () OVER(ORDER BY CUSTOMER_ID ) AS CUSTOMER_KEY ,[customer_id]
           ,CONCAT(FIRST_NAME,' ',LAST_NAME) AS CUSTOMER_NAME 
           ,CASE
                          WHEN UPPER(LTRIM(RTRIM(GENDER))) = 'F' THEN 'Female'
                          WHEN UPPER(LTRIM(RTRIM(GENDER))) = 'M' THEN 'Male'
                      ELSE 'n/a'
            END AS GENDER 
           ,CONCAT(CASE 
                          WHEN UPPER (LTRIM(RTRIM(COUNTRY))) = 'EGYPT' THEN 'EGY'
                          WHEN UPPER (LTRIM(RTRIM(COUNTRY))) = 'JORDAN' THEN 'JRD'
                          WHEN UPPER (LTRIM(RTRIM(COUNTRY))) = 'KUWAIT' THEN 'KWT'
                          WHEN UPPER (LTRIM(RTRIM(COUNTRY))) = 'Saudi Arabia' THEN 'SDA'
                          WHEN UPPER (LTRIM(RTRIM(COUNTRY))) = 'UAE' THEN 'UAE'
                      ELSE 'N/A'
             END  
             ,'-',        
                   CASE                       
                          WHEN UPPER(CITY) = NULL THEN 'N/A'
                          ELSE CITY 
             END )                                           AS COUNTRY_CITY 
      ,[signup_date]
      ,[customer_segment]
      ,lower(
             replace(  first_name+'.'+last_name , ' ' , '.'  )
                                                              +'@gmail.com')
                                                                               as email 
  FROM  [beginner].[CRM_CUSTOMERS ]
