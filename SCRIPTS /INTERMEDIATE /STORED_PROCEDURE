INSERT INTO  [intermediate].[ERP_PRODUCT] (
             PRODUCT_KEY,
             PRODUCT_ID,
             PRODUCT_NAME,
             CATEGORY,
             BRAND,
             UNIT_COST,
             UNIT_PRICE,
             UNIT_PROFIT,
             SUPPLIER_ID)
                            SELECT   ROW_NUMBER () OVER(ORDER By product_id  ) AS product_key  
      ,[product_id]
      ,[product_name]
      ,[category]
      ,case 
            when brand IS NULL then 'n/a' else brand end as  brand1 
     , ROUND (UNIT_COST ,1) AS UNIT_COST_1 
     , ROUND (unit_price,1) AS UNIT_PRICE_1   
     , ROUND(unit_price-unit_cost,1) AS  UNIT_PROFIT
      ,[supplier_id]
  FROM [E_Commerce].[beginner].[ERP_PRODUCTS ]
