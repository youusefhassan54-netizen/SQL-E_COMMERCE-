  TRUNCATE TABLE [intermediate].[SAL_ORDER] 
  GO 
  INSERT INTO [intermediate].[SAL_ORDER] (
                ORDER_KEY,
                ORDER_ID,
                CUSTOMER_ID,
                ORDER_DATE,
                ORDER_STATUS,
                SALES_CHANNEL,
                COUNTRY) 
                        SELECT ROW_NUMBER() OVER(ORDER BY ORDER_ID) AS ORDER_KEY  
      ,[order_id]
      ,[customer_id]
      ,[order_date]
      ,[order_status]
      ,[sales_channel]
      ,CASE 
                          WHEN UPPER (LTRIM(RTRIM(shipping_country))) = 'EGYPT'  THEN  'EGY'
                          WHEN UPPER (LTRIM(RTRIM(shipping_country))) = 'JORDAN' THEN 'JRD'
                          WHEN UPPER (LTRIM(RTRIM(shipping_country))) = 'KUWAIT' THEN 'KWT'
                          WHEN UPPER (LTRIM(RTRIM(shipping_country))) = 'Saudi Arabia' THEN 'SDA'
                          WHEN UPPER (LTRIM(RTRIM(shipping_country))) = 'UAE' THEN 'UAE'
                      ELSE 'N/A'
             END AS COUNTRY 
  FROM [E_Commerce].[beginner].[SAL_ORDERS ]
