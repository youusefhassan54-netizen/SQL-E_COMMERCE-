        'CUSTOMER_ID',
        COUNT(*),

        SUM
        (
            CASE
                WHEN CUSTOMER_ID IS NULL THEN 1
                ELSE 0
            END
        ),

        SUM
        (
            CASE
                WHEN CUSTOMER_ID IS NOT NULL
                 AND LTRIM(RTRIM(CAST(CUSTOMER_ID AS VARCHAR(100)))) = ''
                THEN 1
                ELSE 0
            END
        ),

        COUNT(*) - COUNT(DISTINCT CUSTOMER_ID),

        CASE
            WHEN
                SUM(CASE WHEN CUSTOMER_ID IS NULL THEN 1 ELSE 0 END) > 0
                OR
                COUNT(*) - COUNT(DISTINCT CUSTOMER_ID) > 0
            THEN 'ISSUES FOUND'
            ELSE 'PASS'
        END

    FROM [intermediate].[CRM_CUSTOMER];


    ---------------------------------------------------------
    -- ERP_INVENTORY
