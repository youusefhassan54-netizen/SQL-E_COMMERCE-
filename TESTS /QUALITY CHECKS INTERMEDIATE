USE E_Commerce;
GO

SET NOCOUNT ON;

BEGIN TRY

    BEGIN TRANSACTION;

    ---------------------------------------------------------
    -- TABLE 1 : CRM_CUSTOMER
    ---------------------------------------------------------

    DECLARE @TableName SYSNAME;
    DECLARE @BusinessKey SYSNAME;
    DECLARE @SQL NVARCHAR(MAX);

    DECLARE TableCursor CURSOR FOR

    SELECT *
    FROM
    (
        VALUES
        ('CRM_CUSTOMER',  'CUSTOMER_ID'),
        ('ERP_INVENTORY', 'PRODUCT_ID'),
        ('ERP_PRODUCT',   'PRODUCT_ID'),
        ('SAL_ORDER',     'ORDER_ID')
    ) AS T(TableName, BusinessKey);

    OPEN TableCursor;

    FETCH NEXT FROM TableCursor
    INTO @TableName, @BusinessKey;


    WHILE @@FETCH_STATUS = 0
    BEGIN

        -----------------------------------------------------
        -- 1. TRIM ALL TEXT COLUMNS
        -----------------------------------------------------

        SET @SQL = N'';

        SELECT @SQL = @SQL +
            N'UPDATE [intermediate].[' + @TableName + N']
              SET [' + c.name + N'] =
                  NULLIF(LTRIM(RTRIM([' + c.name + N'])), '''');'
        FROM sys.columns c
        JOIN sys.tables t
            ON c.object_id = t.object_id
        JOIN sys.schemas s
            ON t.schema_id = s.schema_id
        WHERE s.name = 'intermediate'
          AND t.name = @TableName
          AND c.system_type_id IN
              (
                  SELECT system_type_id
                  FROM sys.types
                  WHERE name IN
                  (
                      'varchar',
                      'nvarchar',
                      'char',
                      'nchar'
                  )
              );

        IF @SQL <> N''
            EXEC sp_executesql @SQL;


        -----------------------------------------------------
        -- 2. REMOVE DUPLICATES AUTOMATICALLY
        -----------------------------------------------------

        SET @SQL = N'
        ;WITH Duplicates AS
        (
            SELECT *,
                   ROW_NUMBER() OVER
                   (
                       PARTITION BY [' + @BusinessKey + N']
                       ORDER BY (SELECT NULL)
                   ) AS rn
            FROM [intermediate].[' + @TableName + N']
            WHERE [' + @BusinessKey + N'] IS NOT NULL
        )
        DELETE FROM Duplicates
        WHERE rn > 1;';

        EXEC sp_executesql @SQL;


        -----------------------------------------------------
        -- NEXT TABLE
        -----------------------------------------------------

        FETCH NEXT FROM TableCursor
        INTO @TableName, @BusinessKey;

    END;


    CLOSE TableCursor;
    DEALLOCATE TableCursor;


    ---------------------------------------------------------
    -- 3. FINAL QUALITY REPORT
    ---------------------------------------------------------

    IF OBJECT_ID('tempdb..#QualityReport') IS NOT NULL
        DROP TABLE #QualityReport;

    CREATE TABLE #QualityReport
    (
        Table_Name NVARCHAR(100),
        Business_Key NVARCHAR(100),
        Total_Rows INT,
        NULL_Keys INT,
        Blank_Keys INT,
        Duplicate_Rows INT,
        Quality_Status NVARCHAR(50)
    );


    ---------------------------------------------------------
    -- CRM_CUSTOMER
    ---------------------------------------------------------

