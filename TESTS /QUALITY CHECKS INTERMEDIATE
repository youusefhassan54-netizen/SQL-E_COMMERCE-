);


/* =====================================================
   1. CRM_CUSTOMER
   ===================================================== */

INSERT INTO #QualityCheck
SELECT
    'CRM_CUSTOMER',
    'CUSTOMER_ID',
    COUNT(*),
    SUM(CASE WHEN CUSTOMER_ID IS NULL THEN 1 ELSE 0 END),
    SUM(CASE
            WHEN CUSTOMER_ID IS NOT NULL
             AND LTRIM(RTRIM(CAST(CUSTOMER_ID AS VARCHAR(100)))) = ''
            THEN 1 ELSE 0
        END),
    COUNT(*) - COUNT(DISTINCT CUSTOMER_ID),
    COUNT(*) - COUNT(DISTINCT CUSTOMER_ID),
    CASE
        WHEN SUM(CASE WHEN CUSTOMER_ID IS NULL THEN 1 ELSE 0 END) = 0
         AND COUNT(*) = COUNT(DISTINCT CUSTOMER_ID)
        THEN 'GOOD'
        ELSE 'ISSUES FOUND'
    END
