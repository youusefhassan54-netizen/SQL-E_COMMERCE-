CREATE TABLE #QualityCheck
(
    Table_Name NVARCHAR(100),
    PK_Column NVARCHAR(100),
    Total_Rows BIGINT,
    NULL_Rows BIGINT,
    Blank_Rows BIGINT,
    Duplicate_Groups BIGINT,
    Duplicate_Rows BIGINT,
